# ---------------------------------------------------------
# PYTHON
# ---------------------------------------------------------

# Python creates these cache files automatically when code runs.
# They are machine-generated and do not need to be stored in Git.
__pycache__/
*.py[cod]

# Pytest creates this cache when automated tests run.
.pytest_cache/

# ---------------------------------------------------------
# VIRTUAL ENVIRONMENT
# ---------------------------------------------------------

# My virtual environment contains locally installed Python packages.
# Anyone using the project should create their own environment from
# requirements.txt rather than committing my local environment.
.venv/
venv/


# ---------------------------------------------------------
# ENVIRONMENT VARIABLES / SECRETS
# ---------------------------------------------------------

# My Gemini API key is stored in a local .env file.
# These rules make sure it is never committed to GitHub.
.env
.env.*


# ---------------------------------------------------------
# IDE / OPERATING SYSTEM FILES
# ---------------------------------------------------------

.vscode/
.DS_Store
Thumbs.db


# ---------------------------------------------------------
# GENERATED OUTPUTS
# ---------------------------------------------------------

# Assessment reports are generated by the application.
# I can remove this line later if I decide to deliberately include
# selected example reports in the portfolio repository.
outputs/*.md

# ---------------------------------------------------------
# SOURCE DOCUMENTS
# ---------------------------------------------------------

# Public source documents used locally are not committed to the
# repository. The README identifies the source used by the prototype.
data/*.pdf

# Temporary embedding learning experiment
src/test_embeddings.py